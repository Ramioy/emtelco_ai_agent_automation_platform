# ==============================================================================
# THE ONLY VALUE YOU HAVE TO FILL IN
# ==============================================================================
# Paste your DeepSeek API key between the "=" and the end of the line, with no
# quotes and no spaces. Get one at https://platform.deepseek.com, or use the key
# you were sent.
#
#   DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# The stack refuses to provision with this empty and tells you so by name.
# Everything below this block already has a working default: you can ignore it.
DEEPSEEK_API_KEY=

# ==============================================================================
# Everything below has a working default. Change it only if you want to.
# ==============================================================================

# ------------------------------------------------------------------------------
# Microservice
# ------------------------------------------------------------------------------
# Static key the microservice requires in the X-API-Key header. The same value is
# provisioned into the n8n "Tools API Key" credential, so changing it here changes
# both sides at once.
TOOLS_API_KEY=local-demo-tools-key

# Second key, for the operations console only. It is what makes the console's access
# distinguishable from a customer's: the list endpoints (every order, every warranty, every
# support ticket) and the state-changing development endpoints answer only to this key, and a
# caller holding it is outside the per-customer isolation rule. It must NOT equal
# TOOLS_API_KEY; if it does, the operator endpoints refuse everyone rather than promoting the
# agent.
OPERATOR_API_KEY=local-demo-operator-key

# ------------------------------------------------------------------------------
# Per-user isolation
# ------------------------------------------------------------------------------
# Who the microservice believes the customer is. LibreChat injects its authenticated user id
# into the X-End-User-Id header, the n8n workflow forwards it on every tool call, and the
# microservice links that user to the first cedula they verify.
#
#   IDENTITY_ISOLATION=enforced   (shipped default) A request with no X-End-User-Id header
#                                 cannot touch customer data at all, and an end user already
#                                 linked to one customer is refused a 403 on any other. To
#                                 test with curl, send a header of your own, for example
#                                 -H "x-end-user-id: reviewer-1".
#   IDENTITY_ISOLATION=disabled   No boundary: any caller reads and writes any customer, which
#                                 is what this system did before the header existed. Offline
#                                 testing only. The service logs a warning at every boot while
#                                 it is on, and GET /health reports it.
IDENTITY_ISOLATION=enforced

# What happens when an end user who is already linked to one customer presents a different
# cedula.
#
#   IDENTITY_REBINDING=denied     (shipped default) Refused with a 403; the agent turns that
#                                 into "no puedo consultar datos de otra persona". A reviewer
#                                 who wants to try a second customer sends a different
#                                 X-End-User-Id, which is the same thing as a second LibreChat
#                                 account, rather than switching this off.
#   IDENTITY_REBINDING=allowed    The link moves to the new cedula. This gives away most of the
#                                 protection, so it exists only for a shared demo machine where
#                                 several people take turns under one login.
IDENTITY_REBINDING=denied

# ------------------------------------------------------------------------------
# n8n
# ------------------------------------------------------------------------------
# Timezone n8n uses for scheduling and timestamps.
GENERIC_TIMEZONE=America/Bogota

# Key n8n uses to encrypt credentials at rest. Pinning it here is what makes
# provisioning reproducible: a fresh machine ends up with the same instance key
# instead of a random one. If you change it after the first boot, n8n refuses to
# start until the old n8n data volume is removed (see the README).
N8N_ENCRYPTION_KEY=866e6fdcdccee213b9b2d43e0ed1ce8d

# The n8n owner account created automatically on first boot. You do not need to
# log into n8n to use the agent; this exists so the first-run wizard never
# appears. The password must be at least 8 characters with a digit and a capital.
N8N_OWNER_EMAIL=owner@localhost.local
N8N_OWNER_PASSWORD=Localdemo1
N8N_OWNER_FIRST_NAME=Demo
N8N_OWNER_LAST_NAME=Owner

# ------------------------------------------------------------------------------
# LibreChat
# ------------------------------------------------------------------------------
# Local-demo secrets. They are pre-filled so the stack comes up with one command.
# They protect nothing but data inside your own containers, so they are safe to
# keep for a demo and must be regenerated before any real deployment:
#   CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET, MEILI_MASTER_KEY  openssl rand -hex 32
#   CREDS_IV                                                     openssl rand -hex 16
CREDS_KEY=5f27ed14d5be139a8805b68d09bbc7ed70a1afcdae6600e71be3a794bed47d3f
CREDS_IV=149d9b9cee2f935570c9609a993d8a7b
JWT_SECRET=d1097c462e37e7f63fccca0470f12ab3286c53ecf2a76c028ca5b0b41acf02e7
JWT_REFRESH_SECRET=5596423e9c17cb6d110d10257c7519d36b9b047ae5859e3d6c6bf0b1196d5106
MEILI_MASTER_KEY=b77ce230b534b8444c954b45c913597a
